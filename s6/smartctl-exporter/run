#!/usr/bin/env sh
# smartctl_exporter auto-discovers drives. On Dell hosts with PERC
# RAID, `smartctl --scan` returns both the real drives at
# /dev/bus/0 -d megaraid,N AND duplicate /dev/sd[a-z] entries that
# always fail to open ("please try adding '-d megaraid,N'"). Each
# failed open takes ~5s, blocking the poll cycle long enough that
# Prometheus scrapes time out.
#
# Detect megaraid passthrough and exclude the bogus /dev/sd[a-z]
# entries on those hosts. On plain SATA hosts (Unraid etc.) the
# /dev/sd[a-z] entries are the real drives — no exclusion applied.
#
# Regex matches the exporter's *stripped* device label, not the full
# /dev/... path. Per buildDeviceLabel() in smartctl_exporter, /dev/sda
# becomes `sda` and /dev/bus/0 with -d megaraid,0 becomes `bus_0_megaraid_0`.
# So the exclude regex must start with `sd`, not `/dev/sd`.
boot_device_filter() {
  source=$(awk '$2 == "/boot" { print $1; exit }' /host/proc/mounts 2>/dev/null || true)
  case "$source" in
    /dev/*) ;;
    *) return 0 ;;
  esac
  name=${source##*/}
  parent=$name
  sys_path=$(readlink -f "/host/sys/class/block/$name" 2>/dev/null || true)
  case "$sys_path" in
    *"/block/"*) rest=${sys_path#*"/block/"}; parent=${rest%%/*} ;;
  esac
  printf '^(/dev/)?(%s|%s)$' "$parent" "$name"
}

BOOT_DEVICE_EXCLUDE=$(boot_device_filter)
if [ -n "$BOOT_DEVICE_EXCLUDE" ]; then
  echo "[smartctl-exporter] excluding host /boot device(s): $BOOT_DEVICE_EXCLUDE"
fi

if smartctl --scan 2>/dev/null | grep -q 'megaraid'; then
  echo "[smartctl-exporter] megaraid passthrough detected — excluding sd[a-z] phantoms"
  EXCLUDE='^sd[a-z]'
  if [ -n "$BOOT_DEVICE_EXCLUDE" ]; then
    EXCLUDE="$EXCLUDE|$BOOT_DEVICE_EXCLUDE"
  fi
  exec /usr/local/bin/smartctl_exporter \
    --web.listen-address=:9633 \
    --smartctl.device-exclude="$EXCLUDE"
fi
if [ -n "$BOOT_DEVICE_EXCLUDE" ]; then
  exec /usr/local/bin/smartctl_exporter \
    --web.listen-address=:9633 \
    --smartctl.device-exclude="$BOOT_DEVICE_EXCLUDE"
fi
exec /usr/local/bin/smartctl_exporter --web.listen-address=:9633
